table Card {
    id: ulong (id: 0);
    card_id: string (id: 1);
    text: string (id: 2);
    date_created: ulong (id: 3);

    /// objectbox: index=hnsw, hnsw-dimensions=256, hnsw-neighbors-per-node=16, hnsw-indexing-search-count=100, hnsw-distance-type=DotProduct
    embedding: [float] (id: 4);
}
